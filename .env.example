# ── DeployForge Configuration ──

# Application
DF_DEBUG=true
DF_ADMIN_API_KEY=change-this-to-a-random-string

# Auth: when true, registration is disabled until email verification ships (see api/routers/auth.py).
DF_REQUIRE_EMAIL_VERIFICATION=false

# Rate limits: max requests per hour per API key (free tier = default tier in Redis until billing sets tier).
DF_RATE_LIMIT_FREE=50
DF_RATE_LIMIT_PRO=100
DF_RATE_LIMIT_WINDOW_SECONDS=3600

# Gemini prompt/response excerpts (see core/ai/gemini_client.py, admin GET .../ai-interactions).
DF_AI_DEBUG_IO=false
DF_AI_DEBUG_MAX_CHARS=8000
DF_AI_PERSIST_IO_EXCERPTS=false

# Dockerfile: optional plan (Flash); two-phase metadata+body (default); critic+refine (extra cost).
DF_AI_DOCKERFILE_PLAN_ENABLED=true
DF_AI_DOCKERFILE_PLAN_JSON_REPAIR_ENABLED=true
DF_AI_DOCKERFILE_TWO_PHASE_ENABLED=true
DF_AI_GENERATION_OUTPUT_FLOOR_TOKENS=4096
DF_AI_GENERATION_OUTPUT_FLOOR_MONOREPO_TOKENS=8192
DF_AI_GENERATION_USE_FLASH_FOR_SIMPLE=false
DF_AI_JSON_REPAIR_SECOND_ATTEMPT_ENABLED=true
# Reserved (0 = off): future Files API threshold for huge prompts.
# DF_GEMINI_FILES_API_PROMPT_TOKEN_THRESHOLD=0
DF_AI_DOCKERFILE_CRITIC_REFINE_ENABLED=false

# Admin reporter: LLM summary only on aggregate metrics. Beat schedules reporter_run daily when enabled.
DF_REPORTER_LLM_ENABLED=false
DF_REPORTER_BEAT_ENABLED=false

# Database (docker-compose handles this automatically)
DF_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deployforge
DF_REDIS_URL=redis://localhost:6379/0

# Gemini AI (REQUIRED — get from https://aistudio.google.com/apikey)
DF_GEMINI_API_KEY=your-gemini-api-key-here

# Optional: longer backoff between HTTP retries (seconds); jitter reduces synchronized retries.
DF_GEMINI_RETRY_BACKOFF_BASE_SECONDS=8
DF_GEMINI_RETRY_BACKOFF_MAX_SECONDS=180
DF_GEMINI_RETRY_BACKOFF_JITTER_RATIO=0.25
# After primary (DF_GEMINI_PRO_MODEL) fails with 503/429, try this model with the same retry loop.
# Typical: Pro overload → Flash. Only used when the caller does not pass an explicit model.
DF_GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# When Gemini returns HTTP 200 but no text (often MAX_TOKENS), bump max_output_tokens up to this cap per request.
# DF_GEMINI_MAX_OUTPUT_TOKENS_CAP=16384
# Full pipeline Celery task wall clock (clone + AI + up to DF_MAX_BUILD_ATTEMPTS builds). Raise if builds time out in worker.
# DF_CELERY_PIPELINE_TASK_TIME_LIMIT_SECONDS=7200
# DF_CELERY_PIPELINE_TASK_SOFT_TIME_LIMIT_SECONDS=6600
# Full pipeline Celery retries only for transient Gemini errors (503/429). Countdown grows exponentially.
DF_CELERY_TRANSIENT_MAX_RETRIES=3
DF_CELERY_TRANSIENT_RETRY_COUNTDOWN_BASE=90
DF_CELERY_TRANSIENT_RETRY_COUNTDOWN_MAX=600

# Google Cloud Platform (REQUIRED for sandbox build & deploy test)
 
# Optional: GCP service account (alternative to gcloud auth)
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
