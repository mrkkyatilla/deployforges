# Copy to repo root as .env on the server (not only deploy/)

DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Override localhost URLs — docker-compose.vps.yml sets DB/Redis URLs automatically;
# keep these for tools running outside compose if needed:
# DF_DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/deployforge

DF_DEBUG=false
# API rate limits (requests per hour per X-API-Key; raise for self-host smoke tests).
DF_RATE_LIMIT_FREE=50
DF_RATE_LIMIT_PRO=100
DF_RATE_LIMIT_WINDOW_SECONDS=3600
# Gemini IO: logs (DF_AI_DEBUG_IO) and/or DB excerpts on ai_interactions (DF_AI_PERSIST_IO_EXCERPTS).
DF_AI_DEBUG_IO=false
DF_AI_DEBUG_MAX_CHARS=8000
DF_AI_PERSIST_IO_EXCERPTS=false
DF_ADMIN_API_KEY=CHANGE_ME_RANDOM_SECRET

# Dockerfile plan (Flash) + optional critic/refine; reporter (admin + optional Celery beat).
DF_AI_DOCKERFILE_PLAN_ENABLED=true
DF_AI_DOCKERFILE_CRITIC_REFINE_ENABLED=false
DF_REPORTER_LLM_ENABLED=false
DF_REPORTER_BEAT_ENABLED=false

# When true: POST /auth/register returns 501 until email verification is implemented.
# Self-host: leave false. Production: set true only after SMTP + verify endpoints exist.
DF_REQUIRE_EMAIL_VERIFICATION=false

DF_GEMINI_API_KEY=
DF_GCP_PROJECT_ID=
DF_GCP_REGION=europe-west1

# Pipeline image build: local_docker | kaniko | skip
# - local_docker: celery-worker needs docker CLI + /var/run/docker.sock (see VPS-DEPLOY.md).
# - kaniko: requires DF_GCP_PROJECT_ID, gcloud in worker image (Dockerfile INSTALL_GCLOUD=1), GCS bucket.
# - skip: no docker/kaniko build; deploy to Cloud Run is skipped if GCP project is empty.
DF_BUILD_BACKEND=local_docker

# Host docker group GID for celery-worker (getent group docker | cut -d: -f3).
# Only used when DF_BUILD_BACKEND=local_docker and docker.sock is mounted.
DOCKER_GID=999

# Rebuild worker with gcloud for Kaniko: INSTALL_GCLOUD=1 docker compose ... --build
# INSTALL_GCLOUD=0

# Optional: GOOGLE_APPLICATION_CREDENTIALS=/path/in/container if using SA JSON
